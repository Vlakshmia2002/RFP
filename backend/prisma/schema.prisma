model Vendor {
  id       Int     @id @default(autoincrement())
  name     String
  email    String
  phone    String?
  address  String?
  proposals Proposal[]
}

model Proposal {
  id       Int     @id @default(autoincrement())
  vendorId Int
  rfpId    Int
  amount   Float
  details  String?
  vendor   Vendor @relation(fields: [vendorId], references: [id])
  rfp      RFP    @relation(fields: [rfpId], references: [id])
}

model RFP {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  totalBudget Float?
  deliveryDays Int?
  terms        String?
  proposals   Proposal[]
}
