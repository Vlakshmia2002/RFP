generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RFP {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  totalBudget  Int?
  deliveryDays Int?
  terms        String?
  createdAt    DateTime   @default(now())
  proposals    Proposal[]
}

model Proposal {
  id         Int     @id @default(autoincrement())
  vendorName String
  score      Int?
  notes      String?
  rfp        RFP     @relation(fields: [rfpId], references: [id])
  rfpId      Int
}
